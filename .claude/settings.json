{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(make test)",
      "Bash(make test-legacy)",
      "Bash(make baseline)",
      "Bash(make characterize)",
      "Bash(make compare)",
      "Bash(make verify)",
      "Bash(make policy)",
      "Bash(make schemas)",
      "Bash(make book-assets)",
      "Bash(make compatibility)",
      "Bash(make compatibility-live)",
      "Bash(make clean)",
      "Bash(python3 -m json.tool .claude/settings.json)",
      "Bash(python3 -m unittest tests.test_protect_files -v)",
      "Bash(python3 -m unittest tests.test_settings_policy -v)",
      "Bash(python3 scripts/verify_artifact.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(legacy_app/**)",
      "Edit(fixtures/golden-master/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "filesystem": {
      "denyWrite": [
        "./legacy_app/",
        "./fixtures/golden-master/"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
