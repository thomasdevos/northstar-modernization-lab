{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "model_record", "field_dependencies", "controls",
               "side_effect_adapters", "coverage", "commands", "files_changed",
               "rejected_cases", "unknowns", "human_decisions"],
  "properties": {
    "task_id": {"const": "REPLAY-FEE-01"},
    "model_record": {
      "type": "object",
      "required": ["reported_model", "claude_code_version"],
      "properties": {
        "reported_model": {"type": "string"},
        "claude_code_version": {"type": "string"}
      }
    },
    "field_dependencies": {"type": "array", "items": {"type": "object"}},
    "controls": {"type": "array", "items": {"type": "object"}},
    "side_effect_adapters": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "array", "items": {"type": "object"}},
    "commands": {"type": "array", "items": {"type": "object"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "rejected_cases": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "human_decisions": {"type": "array", "items": {"type": "string"}}
  }
}
