{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "revision", "model_record", "seams", "cases",
               "commands", "files_changed", "risks", "human_decisions"],
  "properties": {
    "task_id": { "const": "CHAR-FEE-01" },
    "revision": { "type": "string", "minLength": 7 },
    "model_record": {
      "type": "object",
      "required": ["reported_model", "claude_code_version", "captured_at"],
      "properties": {
        "reported_model": { "type": "string" },
        "claude_code_version": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "role", "risk"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "role": { "enum": ["input", "observation", "side_effect"] },
          "risk": { "type": "string" }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fixture", "observation_points", "expected_source",
                     "outcome", "evidence", "status_request"],
        "properties": {
          "id": { "type": "string", "pattern": "^CHAR-[A-Z]+-[0-9]{3}$" },
          "fixture": { "type": "string" },
          "observation_points": { "type": "array", "items": { "type": "string" } },
          "expected_source": { "enum": ["controlled_run", "independent_contract", "unsupported"] },
          "outcome": { "enum": ["pass", "fail", "not_run", "unsafe_to_run"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "status_request": { "enum": ["observed_unreviewed", "expected_failure", "unknown"] }
        }
      }
    },
    "commands": { "type": "array", "items": { "type": "string" } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "human_decisions": { "type": "array", "items": { "type": "string" } }
  }
}
