{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "model_record", "inventory_coverage", "assumptions",
    "tests", "differences", "commands", "files_changed",
    "unsupported_constructs", "unknowns", "human_decisions"
  ],
  "properties": {
    "task_id": {"const": "SEM-FEE-01"},
    "model_record": {
      "type": "object",
      "required": ["reported_model", "claude_code_version", "revision"],
      "properties": {
        "reported_model": {"type": "string"},
        "claude_code_version": {"type": "string"},
        "revision": {"type": "string"}
      }
    },
    "inventory_coverage": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "object"}},
    "tests": {"type": "array", "items": {"type": "object"}},
    "differences": {"type": "array", "items": {"type": "object"}},
    "commands": {"type": "array", "items": {"type": "object"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "unsupported_constructs": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "human_decisions": {"type": "array", "items": {"type": "string"}}
  }
}
