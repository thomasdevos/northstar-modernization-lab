{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "model_record", "consumers", "obligations", "tests", "commands", "files_changed", "unknowns", "human_decisions"],
  "properties": {
    "task_id": {"const": "CONTRACT-RECON-01"},
    "model_record": {
      "type": "object",
      "required": ["reported_model", "claude_code_version"],
      "properties": {
        "reported_model": {"type": "string"},
        "claude_code_version": {"type": "string"}
      }
    },
    "consumers": {"type": "array", "items": {"type": "object"}},
    "obligations": {"type": "array", "items": {"type": "object"}},
    "tests": {"type": "array", "items": {"type": "object"}},
    "commands": {"type": "array", "items": {"type": "object"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "human_decisions": {"type": "array", "items": {"type": "string"}}
  }
}
